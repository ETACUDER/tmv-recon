# Database
DATABASE_URL=sqlite:///./tally.db

# LLM Provider Configuration
# Options: azure-claude (default), azure-grok, azure-openai, direct-claude
LLM_PROVIDER=azure-claude

# Azure OpenAI Configuration (for Azure-based providers)
AZURE_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_API_KEY=your-azure-api-key
AZURE_DEPLOYMENT_NAME=claude-sonnet-4-5

# Direct Anthropic API (fallback/legacy - only needed if LLM_PROVIDER=direct-claude)
ANTHROPIC_API_KEY=your-anthropic-key-here
